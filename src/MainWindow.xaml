<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="G7 Pro Xbox Wireless — Community Preview" Width="1020" Height="900" MinWidth="820" MinHeight="680" Background="#0D121C" Foreground="#EAF0FA" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#25334A"/><Setter Property="Foreground" Value="#F1F5FD"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.40"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#ABBBD2"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#171F2E"/><Setter Property="BorderBrush" Value="#2A3549"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Step" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,24,30,24">
  <DockPanel Margin="0,0,0,6"><TextBlock Text="G7 PRO / COMMUNITY TOOLS" Foreground="#78DCC2" FontWeight="SemiBold"/><TextBlock Text="v0.1.0 · Preview" Foreground="#ABBBD2" HorizontalAlignment="Right"/></DockPanel>
  <TextBlock Text="Xbox Wireless" FontSize="36" FontWeight="SemiBold" LineHeight="46"/>
  <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,18" Text="Convert a supported standard G7 Pro receiver using Wuchang dongle firmware. Separate from the pairing utility. Independent project; not affiliated with GameSir or Xbox."/>
  <Border Background="#2C2820" CornerRadius="10" Padding="15" Margin="0,0,0,18"><TextBlock Foreground="#F2D7A5" Text="Tested on one standard receiver: firmware 1.46 → Wuchang 5.12, with wireless input on Xbox Series S. Other hardware is unverified. A backup is required, but restoration is not tested or included."/></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Style="{StaticResource Step}" Text="01   Bring the official firmware"/>
   <TextBlock Style="{StaticResource Muted}" Text="Download GameSir’s Wuchang firmware package and extract it. Select the original “G7 Pro WFF Dongle 5.12 Flash Tool - PID Protected.exe”. Controller firmware is not needed." Margin="0,0,0,12"/>
   <WrapPanel><Button x:Name="DownloadFirmware" Content="Get official firmware"/><Button x:Name="ChooseFirmware" Content="Select dongle updater…"/></WrapPanel>
   <TextBlock x:Name="FirmwareStatus" Text="No firmware selected. Vendor firmware is not bundled with this app." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Style="{StaticResource Step}" Text="02   Back up your receiver"/>
   <TextBlock Style="{StaticResource Muted}" Text="Close GameSir apps and connect only the intended receiver to this PC. Connect the controller wirelessly in 2.4 GHz mode with its USB cable unplugged. Hold Xbox + Menu (≡) to enter receiver update mode." Margin="0,0,0,12"/>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Receivers" MinHeight="34" Margin="0,0,12,0" VerticalContentAlignment="Center" Foreground="#101826"/><Button Grid.Column="1" x:Name="Scan" Content="Scan receiver"/></Grid>
   <WrapPanel><Button x:Name="Backup" Content="Back up receiver" Background="#77DBC2" Foreground="#102A28"/><Button x:Name="Resume" Content="Load verified backup…"/><Button x:Name="OpenBackups" Content="Open backups"/><Button x:Name="Elevate" Content="Restart as administrator"/></WrapPanel>
   <TextBlock x:Name="BackupStatus" Style="{StaticResource Muted}" Text="Reads all 512 KiB twice and saves matching copies. Downloads a pinned 11 KiB backup reader from GitHub if needed, then runs it in RAM. Does not program flash." Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Style="{StaticResource Step}" Text="03   Convert the receiver"/>
   <TextBlock Style="{StaticResource Muted}" Text="After backup, unplug the receiver for at least 3 seconds. Reconnect it to the same USB port, let the controller reconnect, then hold Xbox + Menu again. Keep this app open during the replug." Margin="0,0,0,10"/>
   <CheckBox x:Name="Acknowledge" Foreground="#D6DFED" Margin="0,0,0,12"><TextBlock Text="I understand that firmware conversion can make the receiver unusable and recovery is not guaranteed."/></CheckBox>
   <WrapPanel><Button x:Name="Launch" Content="Open conversion updater" Background="#77DBC2" Foreground="#102A28"/><Button x:Name="OpenSource" Content="View source &amp; details"/></WrapPanel>
   <TextBlock x:Name="ConversionStatus" Style="{StaticResource Muted}" Text="Requires the verified firmware, a matching backup, and a detected replug. The prepared updater changes product matching only; firmware bytes stay unchanged. Whole-chip erase remains off." Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Style="{StaticResource Step}" Text="04   Verify on Xbox"/>
   <TextBlock Style="{StaticResource Muted}" Text="In the updater, choose Install Firmware and wait for green “Upgrade SUCCESS”, version 5.12, and CRC 4938-FD1F1A2B (or A7D9-AA06E6C9). Then unplug/replug, test wireless input on PC, and move the receiver to Xbox. Test dashboard navigation with no controller USB cable, then power-cycle both devices. A USB device name alone does not confirm Xbox compatibility."/>
  </StackPanel></Border>
  <Border x:Name="StatusPanel" Background="#203048" CornerRadius="10" Padding="16"><StackPanel><TextBlock x:Name="StatusTitle" Text="Ready to begin" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Start by selecting the original official dongle updater." Style="{StaticResource Muted}"/><ProgressBar x:Name="Progress" Height="5" Margin="0,10,0,0" Visibility="Collapsed" Foreground="#77DBC2" Background="#121A28"/></StackPanel></Border>
  <Expander Header="Activity &amp; technical details" Foreground="#ABBBD2" Margin="0,15,0,0"><TextBox x:Name="Activity" Margin="0,10,0,0" Height="160" IsReadOnly="True" Background="#101826" Foreground="#C0CCE0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Expander>
 </StackPanel></ScrollViewer>
</Window>
